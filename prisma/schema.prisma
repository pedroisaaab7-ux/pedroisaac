generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  processos    Processo[]
  notasFase    NotaFase[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Pessoa {
  id          String    @id @default(cuid())
  nome        String
  cpfDigits   String    @unique
  createdAt   DateTime  @default(now())
  processos   Processo[]

  @@index([nome])
  @@index([cpfDigits])
}

model Processo {
  id                    String         @id @default(cuid())
  numeroProcesso        String         @unique
  pessoaId              String
  responsavelUsuarioId  String?
  estrategiaBaseTexto   String
  status                ProcessoStatus @default(ATIVO)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  pessoa                Pessoa         @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  responsavelUsuario    User?          @relation(fields: [responsavelUsuarioId], references: [id], onDelete: SetNull)
  fases                 FaseProcesso[]

  @@index([numeroProcesso])
}

model WorkflowTemplate {
  id          String         @id @default(cuid())
  nome        String
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  fases       FaseTemplate[]
}

model FaseTemplate {
  id                String            @id @default(cuid())
  workflowTemplateId String
  ordem             Int
  grupo             String
  nome              String
  createdAt         DateTime          @default(now())

  workflowTemplate  WorkflowTemplate  @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  fasesProcesso     FaseProcesso[]

  @@index([workflowTemplateId, ordem])
}

model FaseProcesso {
  id               String        @id @default(cuid())
  processoId       String
  faseTemplateId   String
  status           FaseStatus    @default(NAO_INICIADA)
  tesesSelecionadas Json?
  startedAt        DateTime?
  completedAt      DateTime?
  updatedAt        DateTime      @updatedAt

  processo         Processo      @relation(fields: [processoId], references: [id], onDelete: Cascade)
  faseTemplate     FaseTemplate  @relation(fields: [faseTemplateId], references: [id], onDelete: Cascade)
  notas            NotaFase[]

  @@index([processoId])
  @@index([faseTemplateId])
}

model NotaFase {
  id             String       @id @default(cuid())
  faseProcessoId String
  autorUsuarioId String
  texto          String
  createdAt      DateTime     @default(now())

  faseProcesso   FaseProcesso @relation(fields: [faseProcessoId], references: [id], onDelete: Cascade)
  autorUsuario   User         @relation(fields: [autorUsuarioId], references: [id], onDelete: Cascade)

  @@index([faseProcessoId])
  @@index([autorUsuarioId])
}

enum ProcessoStatus {
  ATIVO
  SUSPENSO
  ENCERRADO
}

enum FaseStatus {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
  NAO_APLICAVEL
}
